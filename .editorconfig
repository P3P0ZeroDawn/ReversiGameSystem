root = true

[*.cs]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_diagnostic.IDE0008.severity = warning
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.CA1502.severity = warning
dotnet_code_quality.CA1502.threshold = 10

dotnet_naming_rule.private_instance_fields_use_underscore.severity = warning
dotnet_naming_rule.private_instance_fields_use_underscore.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_use_underscore.style = underscore_camel_case

dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

[*.Designer.cs]
generated_code = true

[src/ReversiGameSystem.Server.Persistence/Model/{Account,AccountSettings,ChatMessage,ChatMute,ChatViolation,Database_model.Context,Database_model,Friendship,GameMatch,GameMove,MatchParticipant,ModerationPattern,ModerationRule,SupportedLocale,VerificationCode}.cs]
generated_code = true
dotnet_diagnostic.CS1591.severity = none

[*.xaml]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
