<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="MainMenuCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#D8E5DC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="MainMenuSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#20342A" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="MainMenuEmptyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#667A6D" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MainMenuLogoutButtonStyle" TargetType="Button"
           BasedOn="{StaticResource AuthenticationSecondaryButtonStyle}">
        <Setter Property="Background" Value="#FFF2F2" />
        <Setter Property="Foreground" Value="#A92C35" />
        <Setter Property="BorderBrush" Value="#C6424B" />
    </Style>
</ResourceDictionary>
