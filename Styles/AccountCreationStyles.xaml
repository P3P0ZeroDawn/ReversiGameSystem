<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="AccountCreationPageStyle" TargetType="Page">
        <Setter Property="Background" Value="White" />
    </Style>

    <Style x:Key="LanguagePanelStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="LanguageLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="LanguageSelectorStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="AccountFormPanelStyle" TargetType="StackPanel">
        <Setter Property="Width" Value="250" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AccountCreationTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="20,0,0,20" />
    </Style>

    <Style x:Key="ProfileRowStyle" TargetType="StackPanel">
        <Setter Property="Width" Value="250" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ProfilePictureButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Margin" Value="20,0,10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="NameFieldPanelStyle" TargetType="StackPanel">
        <Setter Property="Width" Value="150" />
        <Setter Property="Margin" Value="0,0,20,0" />
    </Style>

    <Style x:Key="NameCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="AccountFieldLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="20,0,20,0" />
    </Style>

    <Style x:Key="AccountTextInputStyle" TargetType="TextBox">
        <Setter Property="Height" Value="25" />
        <Setter Property="Margin" Value="20,0,20,10" />
    </Style>

    <Style x:Key="NameInputStyle" TargetType="TextBox"
           BasedOn="{StaticResource AccountTextInputStyle}">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="AccountPasswordInputStyle" TargetType="PasswordBox">
        <Setter Property="Height" Value="25" />
        <Setter Property="Margin" Value="20,0,20,10" />
    </Style>

    <Style x:Key="ConfirmationPasswordInputStyle" TargetType="PasswordBox"
           BasedOn="{StaticResource AccountPasswordInputStyle}">
        <Setter Property="Margin" Value="20,0,20,20" />
    </Style>

    <Style x:Key="AccountActionsPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="AccountActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="90" />
        <Setter Property="Height" Value="30" />
    </Style>

    <Style x:Key="CreateAccountButtonStyle" TargetType="Button"
           BasedOn="{StaticResource AccountActionButtonStyle}">
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="CancelAccountButtonStyle" TargetType="Button"
           BasedOn="{StaticResource AccountActionButtonStyle}">
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
</ResourceDictionary>
