<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="AccountAccessBinding"
                 maxReceivedMessageSize="6291456"
                 receiveTimeout="00:10:00"
                 sendTimeout="00:00:30">
          <readerQuotas maxArrayLength="6291456" />
          <security mode="Transport">
            <transport clientCredentialType="Windows"
                       protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="ServiceMetadataBehavior">
          <serviceMetadata />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <service name="ReversiGameSystem.Server.ServiceApi.AccountAccessService"
               behaviorConfiguration="ServiceMetadataBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8090/ReversiGameSystem" />
          </baseAddresses>
        </host>
        <endpoint address="AccountAccess"
                  binding="netTcpBinding"
                  bindingConfiguration="AccountAccessBinding"
                  contract="ReversiGameSystem.Server.Contracts.Services.IAccountAccessService" />
        <endpoint address="mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
    </services>
  </system.serviceModel>
</configuration>
