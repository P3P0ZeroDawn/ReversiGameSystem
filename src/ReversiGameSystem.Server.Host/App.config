<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="TcpBinding"
                 maxReceivedMessageSize="6291456"
                 receiveTimeout="00:10:00"
                 sendTimeout="00:00:30">
          <readerQuotas maxArrayLength="6291456" />
          <security mode="None" />
        </binding>
        <binding name="DuplexTcpBinding"
                 maxReceivedMessageSize="6291456"
                 receiveTimeout="00:00:45"
                 sendTimeout="00:00:05">
          <readerQuotas maxArrayLength="6291456" />
          <security mode="None" />
        </binding>
      </netTcpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="ServiceMetadataBehavior">
          <serviceMetadata />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <service name="ReversiGameSystem.Server.ServiceApi.AccountAccessService"
               behaviorConfiguration="ServiceMetadataBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8090/ReversiGameSystem" />
          </baseAddresses>
        </host>
        <endpoint address="AccountAccess"
                  binding="netTcpBinding"
                  bindingConfiguration="TcpBinding"
                  contract="ReversiGameSystem.Server.Contracts.Services.IAccountAccessService" />
        <endpoint address="mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
      <service name="ReversiGameSystem.Server.ServiceApi.SessionService"
               behaviorConfiguration="ServiceMetadataBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8091/ReversiGameSystem" />
          </baseAddresses>
        </host>
        <endpoint address="Session" binding="netTcpBinding"
                  bindingConfiguration="TcpBinding"
                  contract="ReversiGameSystem.Server.Contracts.Services.ISessionService" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
      </service>
      <service name="ReversiGameSystem.Server.ServiceApi.PlayerProfileService"
               behaviorConfiguration="ServiceMetadataBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8092/ReversiGameSystem" />
          </baseAddresses>
        </host>
        <endpoint address="PlayerProfile" binding="netTcpBinding"
                  bindingConfiguration="TcpBinding"
                  contract="ReversiGameSystem.Server.Contracts.Services.IPlayerProfileService" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
      </service>
      <service name="ReversiGameSystem.Server.ServiceApi.LeaderboardService"
               behaviorConfiguration="ServiceMetadataBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8093/ReversiGameSystem" />
          </baseAddresses>
        </host>
        <endpoint address="Leaderboard" binding="netTcpBinding"
                  bindingConfiguration="TcpBinding"
                  contract="ReversiGameSystem.Server.Contracts.Services.ILeaderboardService" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
      </service>
      <service name="ReversiGameSystem.Server.ServiceApi.FriendshipService"
               behaviorConfiguration="ServiceMetadataBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8094/ReversiGameSystem" />
          </baseAddresses>
        </host>
        <endpoint address="Friendship" binding="netTcpBinding"
                  bindingConfiguration="DuplexTcpBinding"
                  contract="ReversiGameSystem.Server.Contracts.Services.IFriendshipService" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
      </service>
      <service name="ReversiGameSystem.Server.ServiceApi.MatchLobbyService"
               behaviorConfiguration="ServiceMetadataBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8095/ReversiGameSystem" />
          </baseAddresses>
        </host>
        <endpoint address="MatchLobby" binding="netTcpBinding"
                  bindingConfiguration="DuplexTcpBinding"
                  contract="ReversiGameSystem.Server.Contracts.Services.IMatchLobbyService" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
      </service>
      <service name="ReversiGameSystem.Server.ServiceApi.GameplayMatchService"
               behaviorConfiguration="ServiceMetadataBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8096/ReversiGameSystem" />
          </baseAddresses>
        </host>
        <endpoint address="GameplayMatch" binding="netTcpBinding"
                  bindingConfiguration="DuplexTcpBinding"
                  contract="ReversiGameSystem.Server.Contracts.Services.IGameplayMatchService" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
      </service>
      <service name="ReversiGameSystem.Server.ServiceApi.MatchChatService"
               behaviorConfiguration="ServiceMetadataBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8097/ReversiGameSystem" />
          </baseAddresses>
        </host>
        <endpoint address="MatchChat" binding="netTcpBinding"
                  bindingConfiguration="DuplexTcpBinding"
                  contract="ReversiGameSystem.Server.Contracts.Services.IMatchChatService" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
      </service>
    </services>
  </system.serviceModel>
</configuration>
