<Window x:Class="ReversiGameSystem.Views.MovementHistoryDialogWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="620"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Margin="12" Padding="28"
            Background="White" BorderBrush="#D8E5DC"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#20342A" Opacity="0.2"
                              BlurRadius="18" ShadowDepth="4" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="dialogTitleTextBlock"
                       Style="{StaticResource AuthenticationTitleStyle}"
                       Margin="0,0,0,8"
                       MouseLeftButtonDown="OnTitleMouseLeftButtonDown" />
            <TextBlock x:Name="dialogMessageTextBlock" Grid.Row="1"
                       Style="{StaticResource AuthenticationSupportingTextStyle}"
                       TextWrapping="Wrap" Margin="0,0,0,18" />
            <Grid Grid.Row="2">
                <TextBlock x:Name="emptyMovementsTextBlock"
                           Style="{StaticResource MainMenuEmptyTextStyle}"
                           TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <ScrollViewer x:Name="movementsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="movementsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7FAF8" BorderBrush="#D8E5DC"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SequenceText}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#176A49" />
                                        <TextBlock Grid.Column="1" Text="{Binding DateText}"
                                                   Foreground="#52685B" Margin="14,0,0,0" />
                                        <TextBlock Grid.Row="1" Text="{Binding PlayerText}"
                                                   Margin="0,7,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding PositionText}"
                                                   Margin="14,7,0,0" />
                                        <TextBlock Grid.Row="2" Text="{Binding AffectedText}"
                                                   Foreground="#52685B" Margin="0,5,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Text="{Binding OriginText}"
                                                   Foreground="#52685B" Margin="14,5,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <Button x:Name="closeButton" Grid.Row="3"
                    Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                    IsCancel="True" MinWidth="130"
                    HorizontalAlignment="Right" Margin="0,20,0,0"
                    Click="OnCloseClick" />
        </Grid>
    </Border>
</Window>
