<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="SecureTcpBinding"
                 maxReceivedMessageSize="6291456"
                 receiveTimeout="00:10:00"
                 sendTimeout="00:00:30">
          <readerQuotas maxArrayLength="6291456" />
          <security mode="Transport">
            <transport clientCredentialType="None"
                       protectionLevel="EncryptAndSign" />
          </security>
        </binding>
        <binding name="SecureDuplexTcpBinding"
                 maxReceivedMessageSize="6291456"
                 receiveTimeout="00:00:45"
                 sendTimeout="00:00:05">
          <readerQuotas maxArrayLength="6291456" />
          <security mode="Transport">
            <transport clientCredentialType="None"
                       protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <behaviors>
      <endpointBehaviors>
        <behavior name="ServerCertificateValidationBehavior">
          <clientCredentials>
            <serviceCertificate>
              <authentication certificateValidationMode="PeerOrChainTrust" />
            </serviceCertificate>
          </clientCredentials>
        </behavior>
      </endpointBehaviors>
    </behaviors>
    <client>
      <endpoint name="AccountAccessEndpoint"
                address="net.tcp://localhost:8090/ReversiGameSystem/AccountAccess"
                binding="netTcpBinding"
                bindingConfiguration="SecureTcpBinding"
                behaviorConfiguration="ServerCertificateValidationBehavior"
                contract="ReversiGameSystem.ServerProxy.IAccountAccessService">
        <identity>
          <dns value="ReversiGameServer" />
        </identity>
      </endpoint>
      <endpoint name="SessionEndpoint"
                address="net.tcp://localhost:8091/ReversiGameSystem/Session"
                binding="netTcpBinding"
                bindingConfiguration="SecureTcpBinding"
                behaviorConfiguration="ServerCertificateValidationBehavior"
                contract="ReversiGameSystem.ServerProxy.ISessionService">
        <identity>
          <dns value="ReversiGameServer" />
        </identity>
      </endpoint>
      <endpoint name="PlayerProfileEndpoint"
                address="net.tcp://localhost:8092/ReversiGameSystem/PlayerProfile"
                binding="netTcpBinding"
                bindingConfiguration="SecureTcpBinding"
                behaviorConfiguration="ServerCertificateValidationBehavior"
                contract="ReversiGameSystem.ServerProxy.IPlayerProfileService">
        <identity>
          <dns value="ReversiGameServer" />
        </identity>
      </endpoint>
      <endpoint name="LeaderboardEndpoint"
                address="net.tcp://localhost:8093/ReversiGameSystem/Leaderboard"
                binding="netTcpBinding"
                bindingConfiguration="SecureTcpBinding"
                behaviorConfiguration="ServerCertificateValidationBehavior"
                contract="ReversiGameSystem.ServerProxy.ILeaderboardService">
        <identity>
          <dns value="ReversiGameServer" />
        </identity>
      </endpoint>
      <endpoint name="FriendshipEndpoint"
                address="net.tcp://localhost:8094/ReversiGameSystem/Friendship"
                binding="netTcpBinding"
                bindingConfiguration="SecureDuplexTcpBinding"
                behaviorConfiguration="ServerCertificateValidationBehavior"
                contract="ReversiGameSystem.ServerProxy.IFriendshipService">
        <identity>
          <dns value="ReversiGameServer" />
        </identity>
      </endpoint>
      <endpoint name="MatchLobbyEndpoint"
                address="net.tcp://localhost:8095/ReversiGameSystem/MatchLobby"
                binding="netTcpBinding"
                bindingConfiguration="SecureDuplexTcpBinding"
                behaviorConfiguration="ServerCertificateValidationBehavior"
                contract="ReversiGameSystem.ServerProxy.IMatchLobbyService">
        <identity>
          <dns value="ReversiGameServer" />
        </identity>
      </endpoint>
      <endpoint name="GameplayMatchEndpoint"
                address="net.tcp://localhost:8096/ReversiGameSystem/GameplayMatch"
                binding="netTcpBinding"
                bindingConfiguration="SecureDuplexTcpBinding"
                behaviorConfiguration="ServerCertificateValidationBehavior"
                contract="ReversiGameSystem.ServerProxy.IGameplayMatchService">
        <identity>
          <dns value="ReversiGameServer" />
        </identity>
      </endpoint>
      <endpoint name="MatchChatEndpoint"
                address="net.tcp://localhost:8097/ReversiGameSystem/MatchChat"
                binding="netTcpBinding"
                bindingConfiguration="SecureDuplexTcpBinding"
                behaviorConfiguration="ServerCertificateValidationBehavior"
                contract="ReversiGameSystem.ServerProxy.IMatchChatService">
        <identity>
          <dns value="ReversiGameServer" />
        </identity>
      </endpoint>
    </client>
  </system.serviceModel>
</configuration>
