<Page x:Class="ReversiGameSystem.Views.FriendRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{Binding [FriendRequests_Title]}"
      Style="{StaticResource AuthenticationPageStyle}"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Grid Margin="32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource ApplicationHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{Binding [Application_Name]}"
                       Style="{StaticResource AuthenticationBrandStyle}" />
            <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
                <Label Content="{Binding [Common_LanguageLabel]}"
                       Style="{StaticResource LanguageLabelStyle}" />
                <ComboBox x:Name="languageComboBox"
                          Style="{StaticResource LanguageComboBoxStyle}"
                          SelectedValuePath="Tag"
                          SelectionChanged="OnLanguageSelectionChanged"
                          SelectedValue="{Binding CultureName, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                    <ComboBoxItem Tag="en-US" Content="{Binding [Language_English]}" />
                    <ComboBoxItem Tag="es-MX" Content="{Binding [Language_Spanish]}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" MaxWidth="800" HorizontalAlignment="Stretch" Margin="0,8,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource MainMenuCardStyle}"
                    Padding="32,24" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="140" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding [FriendRequests_Title]}"
                               Style="{StaticResource AuthenticationTitleStyle}"
                               Margin="0,0,0,6" />
                    <TextBlock Grid.Row="1" Text="{Binding [FriendRequests_Description]}"
                               Style="{StaticResource AuthenticationSupportingTextStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,20" />

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                            <ItemsControl x:Name="requestsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource FriendshipRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Width="42" Height="42"
                                                        IsHitTestVisible="False" Focusable="False"
                                                        Style="{StaticResource ProfilePictureButtonStyle}">
                                                    <Button.Background>
                                                        <ImageBrush ImageSource="/Assets/Images/DefaultProfilePicture.png"
                                                                    Stretch="UniformToFill" />
                                                    </Button.Background>
                                                </Button>
                                                <StackPanel Grid.Column="1" Margin="12,0,20,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Request.Sender.Username}"
                                                               FontSize="15" FontWeight="SemiBold"
                                                               Foreground="#20342A"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Request.Sender.Username}" />
                                                    <TextBlock Text="{Binding DateText}"
                                                               Foreground="#52685B" FontSize="13"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                    Content="{Binding [FriendRequests_ReviewButton],
                                                        Source={x:Static localization:LocalizationManager.Instance}}"
                                                    Click="OnReviewRequestClick"
                                                    Style="{StaticResource FriendshipRowActionStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="emptyRequestsTextBlock"
                                   Text="{Binding [FriendRequests_EmptyMessage]}"
                                   Style="{StaticResource MainMenuEmptyTextStyle}"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="Collapsed" Margin="16" />
                    </Grid>
                </Grid>
            </Border>

            <Button Grid.Row="1" Content="{Binding [FriendRequests_BackButton]}"
                    Click="OnBackClick"
                    Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                    MinWidth="180" HorizontalAlignment="Left"
                    Padding="14,8" Margin="0,16,0,0" />
        </Grid>
    </Grid>
</Page>

