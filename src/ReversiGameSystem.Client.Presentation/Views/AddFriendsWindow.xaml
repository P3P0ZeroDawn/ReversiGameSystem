<Window x:Class="ReversiGameSystem.Views.AddFriendsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:validation="clr-namespace:ReversiGameSystem.Validation;assembly=ReversiGameSystem.Client.Validation"
        xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
        Title="{Binding [AddFriends_Title]}" Width="760" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Border Margin="16" Padding="28" Background="White"
            BorderBrush="#D8E5DC" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#20342A" Opacity="0.22" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding [AddFriends_Title]}"
                       Style="{StaticResource AuthenticationTitleStyle}" Margin="0,0,0,8"
                       MouseLeftButtonDown="OnTitleMouseLeftButtonDown" />
            <TextBlock Grid.Row="1" Text="{Binding [AddFriends_Description]}"
                       Style="{StaticResource AuthenticationSupportingTextStyle}"
                       TextWrapping="Wrap" Margin="0,0,0,16" />
            <StackPanel Grid.Row="2">
                <Label Content="{Binding [AddFriends_SearchLabel]}"
                       Target="{Binding ElementName=searchTextBox}"
                       Style="{StaticResource AuthenticationFieldLabelStyle}" />
                <TextBox x:Name="searchTextBox"
                         MaxLength="{x:Static validation:UsernamePolicy.MaximumLength}"
                         Style="{StaticResource AuthenticationTextBoxStyle}"
                         TextChanged="OnSearchTextChanged" Margin="0" />
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,16,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <ItemsControl x:Name="resultsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FriendshipRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Width="42" Height="42"
                                                IsHitTestVisible="False" Focusable="False"
                                                Style="{StaticResource ProfilePictureButtonStyle}">
                                            <Button.Background>
                                                <ImageBrush ImageSource="/Assets/Images/DefaultProfilePicture.png"
                                                            Stretch="UniformToFill" />
                                            </Button.Background>
                                        </Button>
                                        <Button Grid.Column="1" Content="{Binding Username}"
                                                Click="OnProfileClick"
                                                Style="{StaticResource AuthenticationLinkButtonStyle}"
                                                HorizontalContentAlignment="Stretch"
                                                FontSize="15" Margin="12,0,20,0"
                                                VerticalAlignment="Center" />
                                        <Button Grid.Column="2"
                                                Content="{Binding [AddFriends_SendRequestButton], Source={x:Static localization:LocalizationManager.Instance}}"
                                                Click="OnSendRequestClick"
                                                Style="{StaticResource FriendshipRowActionStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="noResultsTextBlock"
                           Text="{Binding [AddFriends_SearchPromptMessage]}"
                           Style="{StaticResource MainMenuEmptyTextStyle}"
                           TextAlignment="Center" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="Collapsed" Margin="16" />
            </Grid>

            <Button Grid.Row="4" Content="{Binding [AddFriends_CloseButton]}"
                    Click="OnCloseClick" IsCancel="True" MinWidth="120"
                    HorizontalAlignment="Right" Margin="0"
                    Style="{StaticResource AuthenticationSecondaryButtonStyle}" />
        </Grid>
    </Border>
</Window>
