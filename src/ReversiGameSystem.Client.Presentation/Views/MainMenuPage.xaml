<Page x:Class="ReversiGameSystem.Views.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{Binding [MainMenu_Title]}"
      Style="{StaticResource AuthenticationPageStyle}"
      Loaded="OnLoaded"
      Unloaded="OnUnloaded"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid Width="1280" Height="800" Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Style="{StaticResource ApplicationHeaderStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="guestIdentityPanel" Grid.Column="0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{Binding [MainMenu_GuestLabel]}"
                               Style="{StaticResource MainMenuEmptyTextStyle}" />
                    <TextBlock x:Name="guestNameTextBlock" MaxWidth="200"
                               HorizontalAlignment="Left" FontSize="16"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="applicationNameTextBlock" Grid.Column="1"
                           Text="{Binding [Application_Name]}"
                           Style="{StaticResource AuthenticationBrandStyle}" />
                <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
                    <Label x:Name="languageLabel" Content="{Binding [Common_LanguageLabel]}"
                           Style="{StaticResource LanguageLabelStyle}" />
                    <ComboBox x:Name="languageComboBox"
                              Style="{StaticResource LanguageComboBoxStyle}"
                              SelectedValuePath="Tag"
                              SelectionChanged="OnLanguageSelectionChanged"
                              SelectedValue="{Binding CultureName, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                        <ComboBoxItem Tag="en-US" Content="{Binding [Language_English]}" />
                        <ComboBoxItem Tag="es-MX" Content="{Binding [Language_Spanish]}" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MainMenuCardStyle}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock x:Name="topWinnersTitleTextBlock"
                                   Text="{Binding [MainMenu_TopWinnersTitle]}"
                                   Style="{StaticResource MainMenuSectionTitleStyle}" />
                        <Separator Margin="0,0,0,14" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="500"
                                      CanContentScroll="False">
                            <StackPanel x:Name="topWinnersPanel">
                                <TextBlock x:Name="topWinnersEmptyTextBlock"
                                           Text="{Binding [MainMenu_TopWinnersEmptyMessage]}"
                                           Style="{StaticResource MainMenuEmptyTextStyle}" />
                                <ItemsControl x:Name="topWinnersItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F7FAF8"
                                                    BorderBrush="#D8E5DC"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Position}"
                                                               FontWeight="Bold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Username}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Username}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding WinsText}"
                                                               Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MainMenuCardStyle}"
                        MaxWidth="460" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock x:Name="mainMenuTitleTextBlock"
                                   Text="{Binding [MainMenu_Title]}"
                                   Style="{StaticResource AuthenticationTitleStyle}"
                                   HorizontalAlignment="Center" />
                        <Button x:Name="createGameButton"
                                Content="{Binding [MainMenu_CreateGameButton]}"
                                Click="OnCreateGameClick"
                                Style="{StaticResource AuthenticationPrimaryButtonStyle}" />
                        <Button x:Name="joinGameButton"
                                Content="{Binding [MainMenu_JoinGameButton]}"
                                Click="OnJoinGameClick"
                                Style="{StaticResource AuthenticationPrimaryButtonStyle}" />
                        <Button x:Name="matchHistoryButton"
                                Content="{Binding [MainMenu_MatchHistoryButton]}"
                                Click="OnMatchHistoryClick"
                                Style="{StaticResource AuthenticationSecondaryButtonStyle}" />
                        <Button x:Name="myProfileButton"
                                Content="{Binding [MainMenu_ProfileButton]}"
                                Click="OnMyProfileClick"
                                Style="{StaticResource AuthenticationSecondaryButtonStyle}" />
                        <Button x:Name="settingsButton"
                                Content="{Binding [MainMenu_SettingsButton]}"
                                Click="OnSettingsClick"
                                Style="{StaticResource AuthenticationSecondaryButtonStyle}" />
                        <Button x:Name="instructionsButton"
                                Content="{Binding [MainMenu_InstructionsButton]}"
                                Click="OnInstructionsClick"
                                Style="{StaticResource AuthenticationSecondaryButtonStyle}" />
                        <Separator Margin="0,16,0,20" />
                        <Button x:Name="logoutButton"
                                Content="{Binding [MainMenu_LogoutButton]}"
                                Click="OnLogoutClick"
                                Style="{StaticResource MainMenuLogoutButtonStyle}"
                                Margin="0" />
                    </StackPanel>
                </Border>

                <Border x:Name="friendsCardBorder" Grid.Column="4"
                        Style="{StaticResource MainMenuCardStyle}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock x:Name="friendsTitleTextBlock"
                                   Text="{Binding [MainMenu_FriendsTitle]}"
                                   Style="{StaticResource MainMenuSectionTitleStyle}" />
                        <Button x:Name="refreshFriendsButton"
                                Content="{Binding [Friends_Refresh]}"
                                Click="OnRefreshFriendsClick"
                                Style="{StaticResource AuthenticationSecondaryButtonStyle}" />
                        <TextBlock x:Name="friendsStatusTextBlock" TextWrapping="Wrap"
                                   Style="{StaticResource MainMenuEmptyTextStyle}" />
                        <StackPanel x:Name="friendsListPanel" Margin="0,4,0,0">
                            <TextBlock x:Name="friendsEmptyTextBlock"
                                       Text="{Binding [MainMenu_FriendsEmptyMessage]}"
                                       Style="{StaticResource MainMenuEmptyTextStyle}"
                                       Visibility="Collapsed" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="220"
                                          CanContentScroll="False">
                                <ItemsControl x:Name="friendsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F7FAF8"
                                                    BorderBrush="#D8E5DC"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Width="34" Height="34"
                                                            IsHitTestVisible="False"
                                                            Style="{StaticResource ProfilePictureButtonStyle}">
                                                        <Button.Background>
                                                            <ImageBrush ImageSource="/Assets/Images/DefaultProfilePicture.png"
                                                                        Stretch="UniformToFill" />
                                                        </Button.Background>
                                                    </Button>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Username}"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Username}"
                                                               Margin="8,0,0,0" />
                                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                                                Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Ellipse Width="10" Height="10" Fill="{Binding PresenceBrush}" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding PresenceText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Page>

