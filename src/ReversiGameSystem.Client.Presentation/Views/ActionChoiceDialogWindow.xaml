<Window x:Class="ReversiGameSystem.Views.ActionChoiceDialogWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="640" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Margin="16" Padding="32"
            Background="White" BorderBrush="#D8E5DC"
            BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#20342A" Opacity="0.22"
                              BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="dialogTitleTextBlock"
                       Style="{StaticResource AuthenticationTitleStyle}"
                       Margin="0,0,0,12"
                       MouseLeftButtonDown="OnTitleMouseLeftButtonDown" />
            <TextBlock x:Name="dialogMessageTextBlock"
                       Style="{StaticResource AuthenticationSupportingTextStyle}"
                       FontSize="14" LineHeight="21"
                       TextWrapping="Wrap" Margin="0,0,0,24" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="primaryButton" MinWidth="130"
                        IsDefault="True"
                        Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                        Margin="0,0,10,0" Click="OnPrimaryClick" />
                <Button x:Name="alternateButton" MinWidth="130"
                        Style="{StaticResource MainMenuLogoutButtonStyle}"
                        Margin="0,0,10,0" Click="OnAlternateClick" />
                <Button x:Name="cancelButton" MinWidth="130"
                        IsCancel="True"
                        Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                        Margin="0" Click="OnCancelClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
