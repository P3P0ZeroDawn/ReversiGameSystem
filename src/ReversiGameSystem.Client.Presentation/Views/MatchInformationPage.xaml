<Page x:Class="ReversiGameSystem.Views.MatchInformationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      xmlns:views="clr-namespace:ReversiGameSystem.Views"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{Binding [MatchInformation_Title]}"
      Style="{StaticResource AuthenticationPageStyle}"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Grid Margin="24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource ApplicationHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{Binding [Application_Name]}"
                       Style="{StaticResource AuthenticationBrandStyle}" />
            <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
                <Label Content="{Binding [Common_LanguageLabel]}"
                       Style="{StaticResource LanguageLabelStyle}" />
                <ComboBox x:Name="languageComboBox"
                          Style="{StaticResource LanguageComboBoxStyle}"
                          SelectedValuePath="Tag"
                          SelectionChanged="OnLanguageSelectionChanged"
                          SelectedValue="{Binding CultureName, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                    <ComboBoxItem Tag="en-US" Content="{Binding [Language_English]}" />
                    <ComboBoxItem Tag="es-MX" Content="{Binding [Language_Spanish]}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
              Margin="0,6,0,10" MaxWidth="1180">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" MinWidth="380" MaxWidth="520" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MainMenuCardStyle}"
                    Padding="20,18" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding [MatchInformation_Title]}"
                               Style="{StaticResource MainMenuSectionTitleStyle}" />
                    <TextBlock x:Name="modeTextBlock" FontSize="13"
                               FontWeight="SemiBold" Foreground="#176A49"
                               Margin="0,0,0,14" />
                    <TextBlock x:Name="blackPlayerTextBlock" TextWrapping="Wrap"
                               Margin="0,0,0,6" />
                    <TextBlock x:Name="whitePlayerTextBlock" TextWrapping="Wrap"
                               Margin="0,0,0,6" />
                    <TextBlock x:Name="stateTextBlock" TextWrapping="Wrap"
                               Margin="0,0,0,6" />
                    <TextBlock x:Name="turnTimeTextBlock" TextWrapping="Wrap"
                               Margin="0,0,0,6" />
                    <TextBlock x:Name="scoreTextBlock" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Separator Margin="0,6,0,12" />
                    <TextBlock Text="{Binding [MatchInformation_ResultLabel]}"
                               FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="resultTextBlock" TextWrapping="Wrap"
                               Foreground="#52685B" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="260" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="boardCaptionTextBlock" Grid.Row="0"
                           FontSize="20" FontWeight="SemiBold" Foreground="#20342A"
                           TextAlignment="Center" Margin="0,0,0,8" />

                <Viewbox Grid.Row="1" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <views:ReversiBoardControl x:Name="matchBoardControl" />
                </Viewbox>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <StackPanel x:Name="replayControlsPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Button Content="{Binding [MatchInformation_PreviousButton]}"
                                Click="OnPreviousClick"
                                Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                                MinWidth="100" Padding="12,6" Margin="0,0,8,0" />
                        <Button x:Name="playPauseButton" Click="OnPlayPauseClick"
                                Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                                MinWidth="100" Padding="12,6" Margin="0,0,8,0" />
                        <Button Content="{Binding [MatchInformation_NextButton]}"
                                Click="OnNextClick"
                                Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                                MinWidth="100" Padding="12,6" Margin="0" />
                    </StackPanel>

                    <TextBlock x:Name="framePositionTextBlock"
                               Style="{StaticResource AuthenticationSupportingTextStyle}"
                               TextAlignment="Center" Margin="0,2,0,6" />

                    <Button Content="{Binding [MatchInformation_CloseButton]}"
                            Click="OnCloseClick"
                            Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                            MinWidth="180" HorizontalAlignment="Center"
                            Padding="14,8" Margin="0" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="4" Style="{StaticResource MainMenuCardStyle}"
                    Padding="18" VerticalAlignment="Stretch"
                    MaxHeight="540">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding [MatchInformation_MovesTitle]}"
                               Style="{StaticResource MainMenuSectionTitleStyle}"
                               Margin="0,0,0,8" />
                    <ListBox x:Name="movesListBox" Grid.Row="1"
                             BorderThickness="0" Background="#F7FAF8"
                             Padding="8" Margin="0,0,0,10"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <Button Grid.Row="2"
                            Content="{Binding [MovementHistory_ViewDetailsButton]}"
                            Click="OnViewMovementHistoryClick"
                            Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                            Padding="12,6" MinWidth="180" HorizontalAlignment="Stretch"
                            Margin="0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

