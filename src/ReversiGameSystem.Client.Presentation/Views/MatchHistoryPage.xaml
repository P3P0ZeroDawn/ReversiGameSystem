<Page x:Class="ReversiGameSystem.Views.MatchHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{Binding [MatchHistory_Title]}"
      Style="{StaticResource AuthenticationPageStyle}"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Grid Margin="32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource ApplicationHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{Binding [Application_Name]}"
                       Style="{StaticResource AuthenticationBrandStyle}" />
            <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
                <Label Content="{Binding [Common_LanguageLabel]}"
                       Style="{StaticResource LanguageLabelStyle}" />
                <ComboBox x:Name="languageComboBox"
                          Style="{StaticResource LanguageComboBoxStyle}"
                          SelectedValuePath="Tag"
                          SelectionChanged="OnLanguageSelectionChanged"
                          SelectedValue="{Binding CultureName, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                    <ComboBoxItem Tag="en-US" Content="{Binding [Language_English]}" />
                    <ComboBoxItem Tag="es-MX" Content="{Binding [Language_Spanish]}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" MaxWidth="860" HorizontalAlignment="Stretch" Margin="0,8,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource MainMenuCardStyle}"
                    Padding="28,20" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding [MatchHistory_Title]}"
                               Style="{StaticResource AuthenticationTitleStyle}"
                               Margin="0,0,0,6" />
                    <TextBlock Grid.Row="1" Text="{Binding [MatchHistory_Description]}"
                               Style="{StaticResource AuthenticationSupportingTextStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,14" />

                    <Grid Grid.Row="2" MinHeight="360">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                            <ItemsControl x:Name="historyItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F7FAF8" BorderBrush="#D8E5DC"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="14,10" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="18"
                                                        Background="{Binding ResultBackground}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ResultSymbol}"
                                                               Foreground="White" FontSize="18"
                                                               FontWeight="Bold" TextAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ResultText}"
                                                               Foreground="{Binding ResultForeground}"
                                                               FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding OpponentText}"
                                                               Style="{StaticResource MainMenuEmptyTextStyle}"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding DateText}"
                                                               Style="{StaticResource MainMenuEmptyTextStyle}"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding StateText}"
                                                               Style="{StaticResource MainMenuEmptyTextStyle}"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding ScoreText}"
                                                               Style="{StaticResource MainMenuEmptyTextStyle}"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding EndReasonText}"
                                                               Style="{StaticResource MainMenuEmptyTextStyle}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="{Binding [MatchHistory_ViewButton], Source={x:Static localization:LocalizationManager.Instance}}"
                                                        Tag="{Binding MatchId}" Click="OnViewMatchClick"
                                                        Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                                                        MinWidth="110" Margin="0"
                                                        Padding="12,6"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="emptyHistoryTextBlock"
                                   Text="{Binding [MatchHistory_EmptyMessage]}"
                                   Style="{StaticResource MainMenuEmptyTextStyle}"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="Collapsed" Margin="16" />
                    </Grid>
                </Grid>
            </Border>

            <Button Grid.Row="1" Content="{Binding [MatchHistory_BackButton]}"
                    Click="OnBackToMenuClick"
                    Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                    MinWidth="180" HorizontalAlignment="Left"
                    Margin="0,12,0,0" />
        </Grid>
    </Grid>
</Page>

