<UserControl x:Class="ReversiGameSystem.Views.ReversiBoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="500" Height="500">
    <Border CornerRadius="4" ClipToBounds="True" Background="#176A49">
        <Grid>
            <Image x:Name="boardBackgroundImage"
                   Source="/ReversiGameSystem.Client.Presentation;component/Assets/Images/DefaultBoardBackground.png"
                   Stretch="Fill" />
            <Image x:Name="boardMaskImage"
                   Source="/ReversiGameSystem.Client.Presentation;component/Assets/Images/BoardMask.png"
                   Stretch="Fill" Visibility="Collapsed"
                   IsHitTestVisible="False" />
            <Grid x:Name="piecesGrid" Margin="15"
                  IsHitTestVisible="False" />
            <Grid x:Name="interactionGrid" Margin="15"
                  Background="Transparent" />
        </Grid>
    </Border>
</UserControl>
