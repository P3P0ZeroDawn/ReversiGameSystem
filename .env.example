# Copy this file to .env and replace YOUR_SQL_SERVER with your SQL Server instance.
# This example uses Windows authentication, so it contains no username or password.
REVERSI_DB_CONNECTION_STRING=Server=YOUR_SQL_SERVER;Database=ReversiGameSystem;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;App=EntityFramework

# For SQL Server authentication, use this form instead and keep the real values only in .env:
# REVERSI_DB_CONNECTION_STRING=Server=YOUR_SQL_SERVER;Database=ReversiGameSystem;User ID=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True;App=EntityFramework

# Server-only mail delivery. Use credentials authorized by your mail provider.
# StartTls requires an encrypted upgrade; Tls encrypts immediately on connection.
REVERSI_MAIL_HOST=smtp.example.com
REVERSI_MAIL_PORT=587
REVERSI_MAIL_SECURITY=StartTls
REVERSI_MAIL_USERNAME=YOUR_MAIL_USER
REVERSI_MAIL_PASSWORD=YOUR_MAIL_PASSWORD
REVERSI_MAIL_FROM_ADDRESS=no-reply@example.com
REVERSI_MAIL_FROM_NAME=Reversi

# Independently generated secret: Base64 encoding of at least 32 random bytes.
# Changing this secret invalidates pending verification codes.
REVERSI_VERIFICATION_SECRET=YOUR_BASE64_VERIFICATION_SECRET
