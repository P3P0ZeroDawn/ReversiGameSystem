<UserControl x:Class="ReversiGameSystem.Views.PlayerStatisticsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
             DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Border Style="{StaticResource MainMenuCardStyle}">
        <StackPanel>
            <TextBlock Text="{Binding [PlayerStatistics_Title]}"
                       Style="{StaticResource MainMenuSectionTitleStyle}" />
            <Separator Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Image Source="/Assets/Images/WinIcon.png"
                       Width="24" Height="24" Margin="0,0,10,0" />
                <TextBlock Text="{Binding [PlayerStatistics_WinsLabel]}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="winsValueTextBlock"
                           Text="{Binding [AccountInformation_UnavailableValue]}"
                           FontWeight="SemiBold" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="{Binding [PlayerStatistics_MatchesPlayedLabel]}" />
                <TextBlock x:Name="matchesPlayedValueTextBlock"
                           Text="{Binding [AccountInformation_UnavailableValue]}"
                           FontWeight="SemiBold" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="{Binding [PlayerStatistics_LossesLabel]}" />
                <TextBlock x:Name="lossesValueTextBlock"
                           Text="{Binding [AccountInformation_UnavailableValue]}"
                           FontWeight="SemiBold" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="{Binding [PlayerStatistics_DrawsLabel]}" />
                <TextBlock x:Name="drawsValueTextBlock"
                           Text="{Binding [AccountInformation_UnavailableValue]}"
                           FontWeight="SemiBold" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="{Binding [PlayerStatistics_WinRateLabel]}" />
                <TextBlock x:Name="winRateValueTextBlock"
                           Text="{Binding [AccountInformation_UnavailableValue]}"
                           FontWeight="SemiBold" Margin="8,0,0,0" />
            </StackPanel>
            <Button x:Name="showStatisticsButton"
                    Content="{Binding [PlayerStatistics_ShowButton]}"
                    Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                    Click="OnShowStatisticsClick" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
