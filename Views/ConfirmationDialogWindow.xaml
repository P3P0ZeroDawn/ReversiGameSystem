<Window x:Class="ReversiGameSystem.Views.ConfirmationDialogWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="560" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <Border Margin="12" Padding="28"
                Background="White" BorderBrush="#D8E5DC"
                BorderThickness="1" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#20342A" Opacity="0.2"
                                  BlurRadius="18" ShadowDepth="4" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="dialogTitleTextBlock"
                           Style="{StaticResource AuthenticationTitleStyle}"
                           Margin="0,0,0,10"
                           MouseLeftButtonDown="OnTitleMouseLeftButtonDown" />
                <TextBlock x:Name="dialogMessageTextBlock"
                           Style="{StaticResource AuthenticationSupportingTextStyle}"
                           FontSize="14" LineHeight="21"
                           TextWrapping="Wrap" Margin="0,0,0,24" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="confirmButton" MinWidth="130"
                            Style="{StaticResource MainMenuLogoutButtonStyle}"
                            Margin="0,0,10,0" Click="OnConfirmClick" />
                    <Button x:Name="cancelButton" MinWidth="130"
                            IsCancel="True" IsDefault="True"
                            Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                            Margin="0" Click="OnCancelClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
