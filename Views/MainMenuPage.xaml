<Page x:Class="ReversiGameSystem.Views.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{Binding [MainMenu_Title]}"
      Style="{StaticResource AuthenticationPageStyle}"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource ApplicationHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="guestIdentityPanel" Grid.Column="0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{Binding [MainMenu_GuestLabel]}"
                           Style="{StaticResource MainMenuEmptyTextStyle}" />
                <TextBlock x:Name="guestNameTextBlock" MaxWidth="200"
                           HorizontalAlignment="Left" FontSize="16"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock x:Name="applicationNameTextBlock" Grid.Column="1"
                       Text="{Binding [Application_Name]}"
                       Style="{StaticResource AuthenticationBrandStyle}" />
            <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
                <Label x:Name="languageLabel" Content="{Binding [Common_LanguageLabel]}"
                       Style="{StaticResource LanguageLabelStyle}" />
                <ComboBox x:Name="languageComboBox"
                          Style="{StaticResource LanguageComboBoxStyle}"
                          SelectedValuePath="Tag"
                          SelectionChanged="OnLanguageSelectionChanged"
                          SelectedValue="{Binding CultureName, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                    <ComboBoxItem Tag="en-US" Content="{Binding [Language_English]}" />
                    <ComboBoxItem Tag="es-MX" Content="{Binding [Language_Spanish]}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <Grid MinWidth="1000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MainMenuCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="topWinnersTitleTextBlock"
                                   Text="{Binding [MainMenu_TopWinnersTitle]}"
                                   Style="{StaticResource MainMenuSectionTitleStyle}" />
                        <Separator Margin="0,0,0,14" />
                        <StackPanel x:Name="topWinnersPanel">
                            <TextBlock Text="{Binding [MainMenu_TopWinnersEmptyMessage]}"
                                       Style="{StaticResource MainMenuEmptyTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MainMenuCardStyle}"
                        MaxWidth="480">
                    <StackPanel>
                        <TextBlock x:Name="mainMenuTitleTextBlock"
                                   Text="{Binding [MainMenu_Title]}"
                                   Style="{StaticResource AuthenticationTitleStyle}" />
                        <Button x:Name="createGameButton"
                                Content="{Binding [MainMenu_CreateGameButton]}"
                                Style="{StaticResource AuthenticationPrimaryButtonStyle}" />
                        <Button x:Name="joinGameButton"
                                Content="{Binding [MainMenu_JoinGameButton]}"
                                Click="OnJoinGameClick"
                                Style="{StaticResource AuthenticationPrimaryButtonStyle}" />
                        <Button x:Name="matchHistoryButton"
                                Content="{Binding [MainMenu_MatchHistoryButton]}"
                                Style="{StaticResource AuthenticationSecondaryButtonStyle}" />
                        <Button x:Name="myProfileButton"
                                Content="{Binding [MainMenu_ProfileButton]}"
                                Style="{StaticResource AuthenticationSecondaryButtonStyle}" />
                        <Separator Margin="0,16,0,20" />
                        <Button x:Name="logoutButton"
                                Content="{Binding [MainMenu_LogoutButton]}"
                                Click="OnLogoutClick"
                                Style="{StaticResource MainMenuLogoutButtonStyle}"
                                Margin="0" />
                    </StackPanel>
                </Border>

                <Border x:Name="friendsCardBorder" Grid.Column="4"
                        Style="{StaticResource MainMenuCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="friendsTitleTextBlock"
                                   Text="{Binding [MainMenu_FriendsTitle]}"
                                   Style="{StaticResource MainMenuSectionTitleStyle}" />
                        <Button x:Name="addFriendButton"
                                Content="{Binding [MainMenu_AddFriendButton]}"
                                Style="{StaticResource AuthenticationPrimaryButtonStyle}" />
                        <StackPanel x:Name="friendsListPanel" Margin="0,4,0,0">
                            <TextBlock Text="{Binding [MainMenu_FriendsEmptyMessage]}"
                                       Style="{StaticResource MainMenuEmptyTextStyle}" />
                        </StackPanel>
                        <Separator Margin="0,18,0,18" />
                        <TextBlock x:Name="friendRequestsTitleTextBlock"
                                   Text="{Binding [MainMenu_FriendRequestsTitle]}"
                                   Style="{StaticResource MainMenuSectionTitleStyle}" />
                        <StackPanel x:Name="friendRequestsPanel">
                            <TextBlock Text="{Binding [MainMenu_FriendRequestsEmptyMessage]}"
                                       Style="{StaticResource MainMenuEmptyTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
