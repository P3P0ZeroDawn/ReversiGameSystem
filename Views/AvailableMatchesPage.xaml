<Page x:Class="ReversiGameSystem.Views.AvailableMatchesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{Binding [AvailableMatches_Title]}"
      Style="{StaticResource AuthenticationPageStyle}"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource ApplicationHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="guestIdentityPanel" Grid.Column="0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{Binding [MainMenu_GuestLabel]}"
                           Style="{StaticResource MainMenuEmptyTextStyle}" />
                <TextBlock x:Name="guestNameTextBlock" MaxWidth="200"
                           HorizontalAlignment="Left" FontSize="16"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock x:Name="applicationNameTextBlock" Grid.Column="1"
                       Text="{Binding [Application_Name]}"
                       Style="{StaticResource AuthenticationBrandStyle}" />
            <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
                <Label x:Name="languageLabel" Content="{Binding [Common_LanguageLabel]}"
                       Style="{StaticResource LanguageLabelStyle}" />
                <ComboBox x:Name="languageComboBox"
                          Style="{StaticResource LanguageComboBoxStyle}"
                          SelectedValuePath="Tag"
                          SelectionChanged="OnLanguageSelectionChanged"
                          SelectedValue="{Binding CultureName, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                    <ComboBoxItem Tag="en-US" Content="{Binding [Language_English]}" />
                    <ComboBoxItem Tag="es-MX" Content="{Binding [Language_Spanish]}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource MainMenuCardStyle}"
                    MaxWidth="760" HorizontalAlignment="Stretch"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="availableMatchesTitleTextBlock"
                               Text="{Binding [AvailableMatches_Title]}"
                               Style="{StaticResource AuthenticationTitleStyle}"
                               Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [AvailableMatches_Intro]}"
                                   Style="{StaticResource AuthenticationSupportingTextStyle}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <Button x:Name="refreshMatchesButton" Grid.Column="1"
                                Content="{Binding [AvailableMatches_RefreshButton]}"
                                Click="OnRefreshMatchesClick"
                                Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                                MinWidth="120" Margin="0,0,10,0" />
                        <Button x:Name="joinWithCodeButton" Grid.Column="2"
                                Content="{Binding [AvailableMatches_JoinWithCodeButton]}"
                                Click="OnJoinWithCodeClick"
                                Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                                MinWidth="180" Margin="0" />
                    </Grid>

                    <Border MinHeight="260" Padding="16"
                            Background="#F7FAF8" BorderBrush="#D8E5DC"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <ItemsControl x:Name="availableMatchesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MainMenuCardStyle}"
                                                Padding="14" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="112" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="40" Height="40"
                                                         Stroke="#C8DACF" StrokeThickness="1">
                                                    <Ellipse.Fill>
                                                        <ImageBrush
                                                            ImageSource="/Assets/Images/DefaultProfilePicture.png"
                                                            Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding HostName}"
                                                               FontSize="16" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CreatedAgoText}"
                                                               Style="{StaticResource MainMenuEmptyTextStyle}" />
                                                    <TextBlock Text="{Binding StateText}"
                                                               Foreground="#176A49" FontSize="12"
                                                               FontWeight="SemiBold" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="4" x:Name="joinMatchButton"
                                                        Content="{Binding [AvailableMatches_JoinButton], Source={x:Static localization:LocalizationManager.Instance}}"
                                                        Tag="{Binding MatchId}"
                                                        Click="OnJoinMatchClick"
                                                        Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                                                        MinWidth="106" Margin="0"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="emptyMatchesTextBlock"
                                       Text="{Binding [AvailableMatches_EmptyMessage]}"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource MainMenuEmptyTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=availableMatchesItemsControl}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding [AvailableMatches_SpectatableTitle]}"
                               Style="{StaticResource MainMenuSectionTitleStyle}"
                               Margin="0,22,0,10" />
                    <Border MinHeight="150" Padding="16"
                            Background="#F7FAF8" BorderBrush="#D8E5DC"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <ItemsControl x:Name="spectatableMatchesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MainMenuCardStyle}"
                                                Padding="14" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="112" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding HostName}"
                                                               FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding StateText}"
                                                               Foreground="#176A49" FontSize="12"
                                                               FontWeight="SemiBold" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="{Binding [AvailableMatches_SpectateButton], Source={x:Static localization:LocalizationManager.Instance}}"
                                                        Tag="{Binding MatchId}"
                                                        Visibility="{Binding SpectateVisibility}"
                                                        Click="OnSpectateMatchClick"
                                                        Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                                                        MinWidth="106" Margin="0"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding [AvailableMatches_NoSpectatableMessage]}"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource MainMenuEmptyTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=spectatableMatchesItemsControl}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button x:Name="backToMenuButton"
                            Content="{Binding [AvailableMatches_BackButton]}"
                            Click="OnBackToMenuClick"
                            Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                            HorizontalAlignment="Left" MinWidth="180"
                            Margin="0,22,0,0" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
