<Page x:Class="ReversiGameSystem.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{Binding [Settings_Title]}"
      Style="{StaticResource AuthenticationPageStyle}"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource ApplicationHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{Binding [Application_Name]}"
                       Style="{StaticResource AuthenticationBrandStyle}" />
            <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
                <Label Content="{Binding [Common_LanguageLabel]}"
                       Style="{StaticResource LanguageLabelStyle}" />
                <ComboBox x:Name="languageComboBox"
                          Style="{StaticResource LanguageComboBoxStyle}"
                          SelectedValuePath="Tag"
                          SelectionChanged="OnLanguageSelectionChanged"
                          SelectedValue="{Binding CultureName, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                    <ComboBoxItem Tag="en-US" Content="{Binding [Language_English]}" />
                    <ComboBoxItem Tag="es-MX" Content="{Binding [Language_Spanish]}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <StackPanel MinWidth="760" MaxWidth="860"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                <Border Style="{StaticResource MainMenuCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Settings_Title]}"
                                   Style="{StaticResource AuthenticationTitleStyle}" />
                        <TextBlock Text="{Binding [Settings_Description]}"
                                   Style="{StaticResource AuthenticationSupportingTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,22" />
                        <CheckBox x:Name="profilePicturesCheckBox"
                                  Content="{Binding [Settings_ProfilePicturesOnPiecesLabel]}"
                                  Style="{StaticResource SettingsOptionCheckBoxStyle}" />
                        <TextBlock Text="{Binding [Settings_ProfilePicturesOnPiecesDescription]}"
                                   Style="{StaticResource AuthenticationSupportingTextStyle}"
                                   TextWrapping="Wrap" Margin="28,0,0,20" />
                        <Separator Margin="0,0,0,18" />
                        <CheckBox x:Name="customBackgroundCheckBox"
                                  Content="{Binding [Settings_CustomBackgroundLabel]}"
                                  Style="{StaticResource SettingsOptionCheckBoxStyle}" />
                        <TextBlock Text="{Binding [Settings_CustomBackgroundDescription]}"
                                   Style="{StaticResource AuthenticationSupportingTextStyle}"
                                   TextWrapping="Wrap" Margin="28,0,0,16" />
                        <Border Width="280" Height="280" HorizontalAlignment="Left"
                                Background="#E9F0EB" CornerRadius="8"
                                BorderBrush="#D8E5DC" BorderThickness="1"
                                Margin="0,0,0,16" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="backgroundPreviewImage"
                                       Stretch="UniformToFill" Visibility="Collapsed" />
                                <Image x:Name="backgroundMaskImage"
                                       Source="/Assets/Images/BoardMask.png"
                                       Stretch="Fill" Visibility="Collapsed"
                                       IsHitTestVisible="False" />
                                <TextBlock x:Name="noBackgroundTextBlock"
                                           Text="{Binding [Settings_NoBackgroundMessage]}"
                                           Style="{StaticResource MainMenuEmptyTextStyle}"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="18" />
                            </Grid>
                        </Border>
                        <Button x:Name="changeBackgroundButton"
                                Content="{Binding [Settings_ChangeBackgroundButton]}"
                                Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                                Click="OnChangeBackgroundClick"
                                Width="260" HorizontalAlignment="Left" Margin="0" />
                    </StackPanel>
                </Border>
                <Button x:Name="backToMenuButton"
                        Content="{Binding [Settings_BackButton]}"
                        Click="OnBackToMenuClick"
                        Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                        Width="180" HorizontalAlignment="Left" Margin="0,22,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
