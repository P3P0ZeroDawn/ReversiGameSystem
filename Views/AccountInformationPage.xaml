<Page x:Class="ReversiGameSystem.Views.AccountInformationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      xmlns:views="clr-namespace:ReversiGameSystem.Views"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{Binding [AccountInformation_Title]}"
      Style="{StaticResource AuthenticationPageStyle}"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Grid Margin="48,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource ApplicationHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="applicationNameTextBlock" Grid.Column="1"
                       Text="{Binding [Application_Name]}"
                       Style="{StaticResource AuthenticationBrandStyle}" />
            <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
                <Label x:Name="languageLabel" Content="{Binding [Common_LanguageLabel]}"
                       Style="{StaticResource LanguageLabelStyle}" />
                <ComboBox x:Name="languageComboBox"
                          Style="{StaticResource LanguageComboBoxStyle}"
                          SelectedValuePath="Tag"
                          SelectionChanged="OnLanguageSelectionChanged"
                          SelectedValue="{Binding CultureName, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                    <ComboBoxItem Tag="en-US" Content="{Binding [Language_English]}" />
                    <ComboBoxItem Tag="es-MX" Content="{Binding [Language_Spanish]}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Bloque principal con ancho extendido (MaxWidth 1480) y tarjetas simétricas -->
        <Grid Grid.Row="1" MaxWidth="1480" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tarjeta Mi Perfil -->
                <Border Grid.Column="0" Style="{StaticResource MainMenuCardStyle}"
                        Padding="36,28" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Título de sección -->
                        <TextBlock x:Name="profileTitleTextBlock"
                                   Text="{Binding [AccountInformation_Title]}"
                                   Style="{StaticResource MainMenuSectionTitleStyle}"
                                   Margin="0,0,0,12" />

                        <Separator Grid.Row="1" Margin="0,0,0,16" />

                        <!-- Contenido del perfil -->
                        <Grid Grid.Row="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Foto de perfil a la izquierda -->
                            <Button x:Name="profilePictureButton" Grid.Column="0"
                                    Width="120" Height="120"
                                    ToolTip="{Binding [AccountInformation_ChangePictureButton]}"
                                    AutomationProperties.Name="{Binding [AccountInformation_ChangePictureButton]}"
                                    Click="OnProfilePictureClick"
                                    Style="{StaticResource ProfilePictureButtonStyle}"
                                    VerticalAlignment="Center">
                                <Button.Background>
                                    <ImageBrush ImageSource="/Assets/Images/DefaultProfilePicture.png"
                                                Stretch="UniformToFill" />
                                </Button.Background>
                            </Button>

                            <!-- Información a la derecha de la foto en 2 columnas equilibradas -->
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Columna de Nombre de Usuario -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [AccountInformation_UsernameLabel]}"
                                               Style="{StaticResource AuthenticationFieldCaptionStyle}" />
                                    <TextBlock x:Name="usernameTextBlock"
                                               Text="{Binding [AccountInformation_UnavailableValue]}"
                                               FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               Margin="0,4,0,0" />
                                    <Button x:Name="modifyUsernameButton"
                                            Content="{Binding [AccountInformation_ChangeUsernameButton]}"
                                            Click="OnModifyUsernameClick"
                                            Style="{StaticResource AuthenticationLinkButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,12,0,0" />
                                </StackPanel>

                                <!-- Columna de Correo y Contraseña (se oculta en perfiles de terceros) -->
                                <StackPanel x:Name="privateAccountPanel" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [AccountInformation_EmailLabel]}"
                                               Style="{StaticResource AuthenticationFieldCaptionStyle}" />
                                    <TextBlock x:Name="emailTextBlock"
                                               Text="{Binding [AccountInformation_UnavailableValue]}"
                                               FontSize="15" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               Margin="0,4,0,0" />
                                    <Button x:Name="changePasswordButton"
                                            Content="{Binding [AccountInformation_ChangePasswordButton]}"
                                            Click="OnChangePasswordClick"
                                            Style="{StaticResource AuthenticationLinkButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,12,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Tarjeta Estadísticas -->
                <views:PlayerStatisticsControl x:Name="playerStatisticsControl"
                                               Grid.Column="2" VerticalAlignment="Stretch" />
            </Grid>

            <!-- Fila inferior: Botones alineados a los extremos del contenedor -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="backToMenuButton"
                        Content="{Binding [AccountInformation_BackButton]}"
                        Click="OnBackToMenuClick"
                        Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                        HorizontalAlignment="Left" MinWidth="180" Margin="0" />
                <Button x:Name="deactivateAccountButton" Grid.Column="1"
                        Content="{Binding [AccountInformation_DeactivateButton]}"
                        Style="{StaticResource MainMenuLogoutButtonStyle}"
                        HorizontalAlignment="Right" MinWidth="180"
                        Click="OnDeactivateAccountClick" Margin="0" />
                <Button x:Name="sendFriendRequestButton" Grid.Column="1"
                        Content="{Binding [AccountInformation_AddFriendButton]}"
                        Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                        HorizontalAlignment="Right" MinWidth="180"
                        Visibility="Collapsed"
                        Click="OnSendFriendRequestClick" Margin="0" />
            </Grid>
        </Grid>
    </Grid>
</Page>

