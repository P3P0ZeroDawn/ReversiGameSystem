<Page x:Class="ReversiGameSystem.Views.FriendRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{Binding [FriendRequests_Title]}"
      Style="{StaticResource AuthenticationPageStyle}"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Grid Margin="32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera de la aplicación -->
        <Grid Grid.Row="0" Style="{StaticResource ApplicationHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{Binding [Application_Name]}"
                       Style="{StaticResource AuthenticationBrandStyle}" />
            <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
                <Label Content="{Binding [Common_LanguageLabel]}"
                       Style="{StaticResource LanguageLabelStyle}" />
                <ComboBox x:Name="languageComboBox"
                          Style="{StaticResource LanguageComboBoxStyle}"
                          SelectedValuePath="Tag"
                          SelectionChanged="OnLanguageSelectionChanged"
                          SelectedValue="{Binding CultureName, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                    <ComboBoxItem Tag="en-US" Content="{Binding [Language_English]}" />
                    <ComboBoxItem Tag="es-MX" Content="{Binding [Language_Spanish]}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Bloque principal responsivo sin scroll global -->
        <Grid Grid.Row="1" MaxWidth="800" HorizontalAlignment="Stretch" Margin="0,8,0,8">
            <Grid.RowDefinitions>
                <!-- Fila 0: Tarjeta elástica que aprovecha el alto vertical -->
                <RowDefinition Height="*" />
                <!-- Fila 1: Botón de retorno (siempre medido y garantizado visible) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Tarjeta de solicitudes de amistad -->
            <Border Grid.Row="0" Style="{StaticResource MainMenuCardStyle}"
                    Padding="28,20" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Fila 0: Título -->
                        <RowDefinition Height="Auto" />
                        <!-- Fila 1: Descripción -->
                        <RowDefinition Height="Auto" />
                        <!-- Fila 2: Lista de solicitudes con scroll independiente -->
                        <RowDefinition Height="*" MinHeight="140" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding [FriendRequests_Title]}"
                               Style="{StaticResource AuthenticationTitleStyle}"
                               Margin="0,0,0,6" />
                    <TextBlock Grid.Row="1" Text="{Binding [FriendRequests_Description]}"
                               Style="{StaticResource AuthenticationSupportingTextStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,14" />

                    <!-- Contenedor de lista de solicitudes y mensaje de lista vacía -->
                    <Grid Grid.Row="2">
                        <ListBox x:Name="requestsListBox"
                                 BorderThickness="0" Background="Transparent"
                                 SelectionChanged="OnRequestSelectionChanged"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7FAF8" BorderBrush="#D8E5DC"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Width="42" Height="42"
                                                    IsHitTestVisible="False"
                                                    Style="{StaticResource ProfilePictureButtonStyle}">
                                                <Button.Background>
                                                    <ImageBrush ImageSource="/Assets/Images/DefaultProfilePicture.png"
                                                                Stretch="UniformToFill" />
                                                </Button.Background>
                                            </Button>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SenderUsername}"
                                                           FontSize="15" FontWeight="SemiBold"
                                                           Foreground="#20342A" />
                                                <TextBlock Text="{Binding DateText}"
                                                           Foreground="#52685B" FontSize="13"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Mensaje de sin solicitudes pendientes -->
                        <TextBlock x:Name="emptyRequestsTextBlock"
                                   Text="{Binding [FriendRequests_EmptyMessage]}"
                                   Style="{StaticResource MainMenuEmptyTextStyle}"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="Collapsed" Margin="16" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Botón Volver al menú (prioridad de visibilidad absoluta, nunca recortado) -->
            <Button Grid.Row="1" Content="{Binding [FriendRequests_BackButton]}"
                    Click="OnBackClick"
                    Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                    MinWidth="180" HorizontalAlignment="Left"
                    Padding="14,8" Margin="0,10,0,0" />
        </Grid>
    </Grid>
</Page>

