<Page x:Class="ReversiGameSystem.Views.MatchCreationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{Binding [MatchCreation_Title]}"
      Style="{StaticResource AuthenticationPageStyle}"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid Width="1280" Height="800" Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Style="{StaticResource ApplicationHeaderStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{Binding [Application_Name]}"
                           Style="{StaticResource AuthenticationBrandStyle}" />
                <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
                    <Label Content="{Binding [Common_LanguageLabel]}"
                           Style="{StaticResource LanguageLabelStyle}" />
                    <ComboBox x:Name="languageComboBox"
                              Style="{StaticResource LanguageComboBoxStyle}"
                              SelectedValuePath="Tag"
                              SelectionChanged="OnLanguageSelectionChanged"
                              SelectedValue="{Binding CultureName, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                        <ComboBoxItem Tag="en-US" Content="{Binding [Language_English]}" />
                        <ComboBoxItem Tag="es-MX" Content="{Binding [Language_Spanish]}" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource AuthenticationCardStyle}"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding [MatchCreation_Title]}"
                               Style="{StaticResource AuthenticationTitleStyle}" />
                    <TextBlock Text="{Binding [MatchCreation_Description]}"
                               Style="{StaticResource AuthenticationSupportingTextStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,22" />
                    <Label Content="{Binding [MatchCreation_TurnTimeLabel]}"
                           Style="{StaticResource AuthenticationFieldLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="turnTimeTextBox"
                                 Style="{StaticResource AuthenticationTextBoxStyle}"
                                 PreviewTextInput="OnTurnTimePreviewTextInput"
                                 MaxLength="3" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding [MatchCreation_SecondsSuffix]}"
                                   VerticalAlignment="Center" Margin="10,0,0,14" />
                    </Grid>
                    <TextBlock Text="{Binding [MatchCreation_TurnTimeHint]}"
                               Style="{StaticResource AuthenticationSupportingTextStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,24" />
                    <Button x:Name="createMatchButton"
                            Content="{Binding [MatchCreation_CreateButton]}"
                            Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                            Click="OnCreateMatchClick" />
                    <Button x:Name="cancelButton"
                            Content="{Binding [Common_CancelButton]}"
                            Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                            Click="OnCancelClick" Margin="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>
</Page>

