<Window x:Class="ReversiGameSystem.Views.MatchSettingsDialogWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="580" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Margin="16" Padding="32"
            Background="White" BorderBrush="#D8E5DC"
            BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#20342A" Opacity="0.22"
                              BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="dialogTitleTextBlock"
                       Style="{StaticResource AuthenticationTitleStyle}"
                       Margin="0,0,0,12"
                       MouseLeftButtonDown="OnTitleMouseLeftButtonDown" />
            <TextBlock x:Name="dialogMessageTextBlock"
                       Style="{StaticResource AuthenticationSupportingTextStyle}"
                       TextWrapping="Wrap" Margin="0,0,0,20" />
            <Label x:Name="turnTimeLabel"
                   Target="{Binding ElementName=turnTimeTextBox}"
                   Style="{StaticResource AuthenticationFieldLabelStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="turnTimeTextBox"
                         Style="{StaticResource AuthenticationTextBoxStyle}"
                         PreviewTextInput="OnTurnTimePreviewTextInput"
                         MaxLength="3" />
                <TextBlock x:Name="secondsSuffixTextBlock" Grid.Column="1"
                           VerticalAlignment="Center" Margin="10,0,0,14" />
            </Grid>
            <TextBlock x:Name="turnTimeHintTextBlock"
                       Style="{StaticResource AuthenticationSupportingTextStyle}"
                       TextWrapping="Wrap" Margin="0,0,0,24" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="cancelButton" MinWidth="120" IsCancel="True"
                        Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                        Margin="0,0,10,0" Click="OnCancelClick" />
                <Button x:Name="saveButton" MinWidth="130" IsDefault="True"
                        Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                        Margin="0" Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
