<Page x:Class="ReversiGameSystem.Views.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      xmlns:views="clr-namespace:ReversiGameSystem.Views"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{Binding [Game_Title]}"
      Style="{StaticResource AuthenticationPageStyle}"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Page.Resources>
        <Style x:Key="GamePlayerCardStyle" TargetType="Border"
               BasedOn="{StaticResource MainMenuCardStyle}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="GamePlayerNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#20342A" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource ApplicationHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <Button x:Name="informationButton" Grid.Column="0" Content="i"
                    Width="40" Height="40" FontSize="22"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    FontWeight="Bold" Padding="0"
                    Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                    Margin="0" Click="OnInformationClick"
                    ToolTip="{Binding [Game_InformationButtonToolTip]}" />
            <TextBlock Grid.Column="1" Text="{Binding [Application_Name]}"
                       Style="{StaticResource AuthenticationBrandStyle}" />
            <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
                <Label Content="{Binding [Common_LanguageLabel]}"
                       Style="{StaticResource LanguageLabelStyle}" />
                <ComboBox x:Name="languageComboBox"
                          Style="{StaticResource LanguageComboBoxStyle}"
                          SelectedValuePath="Tag"
                          SelectionChanged="OnLanguageSelectionChanged"
                          SelectedValue="{Binding CultureName, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                    <ComboBoxItem Tag="en-US" Content="{Binding [Language_English]}" />
                    <ComboBoxItem Tag="es-MX" Content="{Binding [Language_Spanish]}" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center">
            <Grid HorizontalAlignment="Center" Margin="0,12,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="294" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="520" />
                    <ColumnDefinition x:Name="chatSpacingColumn" Width="28" />
                    <ColumnDefinition x:Name="chatColumn" Width="294" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Style="{StaticResource GamePlayerCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="18" Height="18" Fill="#2E2E2E"
                                         Stroke="#161616" StrokeThickness="1"
                                         VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="creatorNameTextBlock" Grid.Column="1"
                                           Style="{StaticResource GamePlayerNameStyle}" />
                            </Grid>
                            <TextBlock x:Name="creatorScoreTextBlock" FontSize="15"
                                       Foreground="#52685B" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GamePlayerCardStyle}" Margin="0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="18" Height="18" Fill="White"
                                         Stroke="#8CA095" StrokeThickness="1"
                                         VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="opponentNameTextBlock" Grid.Column="1"
                                           Style="{StaticResource GamePlayerNameStyle}" />
                            </Grid>
                            <TextBlock x:Name="opponentScoreTextBlock" FontSize="15"
                                       Foreground="#52685B" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="turnTextBlock" FontSize="20"
                               FontWeight="SemiBold" Foreground="#20342A"
                               TextAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock x:Name="turnTimeTextBlock" FontSize="14"
                               Foreground="#52685B" TextAlignment="Center"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="turnStatusTextBlock" FontSize="13"
                               Foreground="#6B5940" TextAlignment="Center"
                               TextWrapping="Wrap" MinHeight="20"
                               Margin="0,0,0,8" />
                    <views:ReversiBoardControl x:Name="gameBoardControl" />
                    <Button x:Name="leaveMatchButton"
                            Content="{Binding [Game_LeaveMatchButton]}"
                            Style="{StaticResource MainMenuLogoutButtonStyle}"
                            Click="OnLeaveMatchClick"
                            Width="220" Margin="0,18,0,0" />
                </StackPanel>

                <Border x:Name="chatPanel" Grid.Column="4"
                        Style="{StaticResource MainMenuCardStyle}"
                        Padding="18" VerticalAlignment="Center">
                    <Grid Height="390">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding [Game_ChatTitle]}"
                                   Style="{StaticResource MainMenuSectionTitleStyle}" />
                        <ListBox x:Name="chatMessagesListBox" Grid.Row="1"
                                 BorderThickness="0" Background="#F7FAF8"
                                 Padding="8" Margin="0,0,0,12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <Grid x:Name="chatComposerGrid" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="chatMessageTextBox" Height="36"
                                     MaxLength="200" Padding="10,6"
                                     Style="{StaticResource AuthenticationTextBoxStyle}"
                                     Margin="0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="OnChatMessageKeyDown" />
                            <Button x:Name="sendMessageButton" Grid.Column="1"
                                    Content="➜" Width="40" Height="36"
                                    Margin="8,0,0,0" Padding="0"
                                    Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                                    Click="OnSendMessageClick"
                                    ToolTip="{Binding [Game_SendMessageButtonToolTip]}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
