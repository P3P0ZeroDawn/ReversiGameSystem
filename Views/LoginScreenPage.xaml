<Page x:Class="ReversiGameSystem.Views.LoginScreenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1280"
      Title="{Binding [LoginScreen_Title]}"
      Style="{StaticResource AuthenticationPageStyle}"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid Width="1280" Height="800" Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Style="{StaticResource ApplicationHeaderStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="applicationNameTextBlock" Grid.Column="1"
                           Text="{Binding [Application_Name]}"
                           Style="{StaticResource AuthenticationBrandStyle}" />
                <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
                    <Label x:Name="languageLabel" Content="{Binding [Common_LanguageLabel]}"
                           Style="{StaticResource LanguageLabelStyle}" />
                    <ComboBox x:Name="languageComboBox"
                              Style="{StaticResource LanguageComboBoxStyle}"
                              SelectedValuePath="Tag"
                              SelectionChanged="OnLanguageSelectionChanged"
                              SelectedValue="{Binding CultureName, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                        <ComboBoxItem Tag="en-US" Content="{Binding [Language_English]}" />
                        <ComboBoxItem Tag="es-MX" Content="{Binding [Language_Spanish]}" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource AuthenticationCardStyle}"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="loginScreenTitleTextBlock"
                               Text="{Binding [LoginScreen_Title]}"
                               Style="{StaticResource AuthenticationTitleStyle}" />

                    <Label x:Name="emailLabel" Content="{Binding [Common_EmailLabel]}"
                           Style="{StaticResource AuthenticationFieldLabelStyle}" />
                    <TextBox x:Name="emailTextBox"
                             Style="{StaticResource AuthenticationTextBoxStyle}" />
                    <Label x:Name="passwordLabel" Content="{Binding [Common_PasswordLabel]}"
                           Style="{StaticResource AuthenticationFieldLabelStyle}" />
                    <PasswordBox x:Name="passwordBox"
                                 Style="{StaticResource AuthenticationPasswordBoxStyle}" />
                    <Button x:Name="forgotPasswordButton"
                            Content="{Binding [LoginScreen_ForgotPasswordText]}"
                            Click="OnForgotPasswordClick"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,18"
                            Style="{StaticResource AuthenticationLinkButtonStyle}" />

                    <Button x:Name="loginButton"
                            Content="{Binding [LoginScreen_SignInButton]}"
                            Click="OnLoginClick"
                            Style="{StaticResource AuthenticationPrimaryButtonStyle}" />
                    <Button x:Name="loginAsGuestButton"
                            Content="{Binding [LoginScreen_GuestButton]}"
                            Click="OnContinueAsGuestClick"
                            Style="{StaticResource AuthenticationSecondaryButtonStyle}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,8,0,0">
                        <TextBlock x:Name="noAccountTextBlock"
                                   Text="{Binding [LoginScreen_NoAccountText]}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource AuthenticationSupportingTextStyle}" />
                        <Button x:Name="createAccountButton"
                                Content="{Binding [LoginScreen_CreateAccountButton]}"
                                Click="OnCreateAccountClick"
                                Style="{StaticResource AuthenticationLinkButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>
</Page>
