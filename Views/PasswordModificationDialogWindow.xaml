<Window x:Class="ReversiGameSystem.Views.PasswordModificationDialogWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <Border Margin="12" Padding="28"
                Background="White" BorderBrush="#D8E5DC"
                BorderThickness="1" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#20342A" Opacity="0.2"
                                  BlurRadius="18" ShadowDepth="4" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="dialogTitleTextBlock"
                           Style="{StaticResource AuthenticationTitleStyle}"
                           Margin="0,0,0,10"
                           MouseLeftButtonDown="OnTitleMouseLeftButtonDown" />
                <TextBlock x:Name="dialogMessageTextBlock"
                           Style="{StaticResource AuthenticationSupportingTextStyle}"
                           TextWrapping="Wrap" Margin="0,0,0,20" />
                <Label x:Name="currentPasswordLabel"
                       Target="{Binding ElementName=currentPasswordBox}"
                       Style="{StaticResource AuthenticationFieldLabelStyle}" />
                <PasswordBox x:Name="currentPasswordBox"
                             Style="{StaticResource AuthenticationPasswordBoxStyle}" />
                <Label x:Name="newPasswordLabel"
                       Target="{Binding ElementName=newPasswordBox}"
                       Style="{StaticResource AuthenticationFieldLabelStyle}" />
                <PasswordBox x:Name="newPasswordBox"
                             Style="{StaticResource AuthenticationPasswordBoxStyle}" />
                <TextBlock x:Name="passwordHintTextBlock"
                           Style="{StaticResource AuthenticationSupportingTextStyle}"
                           TextWrapping="Wrap" Margin="0,-8,0,14" />
                <Label x:Name="confirmationLabel"
                       Target="{Binding ElementName=confirmationBox}"
                       Style="{StaticResource AuthenticationFieldLabelStyle}" />
                <PasswordBox x:Name="confirmationBox"
                             Style="{StaticResource AuthenticationPasswordBoxStyle}"
                             Margin="0,0,0,22" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="cancelButton" MinWidth="120" IsCancel="True"
                            Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                            Margin="0,0,10,0" Click="OnCancelClick" />
                    <Button x:Name="confirmButton" MinWidth="120" IsDefault="True"
                            Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                            Margin="0" Click="OnConfirmClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
