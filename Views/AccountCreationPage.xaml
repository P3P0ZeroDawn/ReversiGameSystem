<Page x:Class="ReversiGameSystem.Views.AccountCreationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:localization="clr-namespace:ReversiGameSystem.Localization"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="{Binding [Account_Creation]}"
      Style="{StaticResource AccountCreationPageStyle}"
      DataContext="{x:Static localization:LocalizationManager.Instance}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="2" Style="{StaticResource LanguagePanelStyle}">
            <Label Content="{Binding [Language]}" Style="{StaticResource LanguageLabelStyle}" />
            <ComboBox x:Name="languageSelector"
                      Style="{StaticResource LanguageSelectorStyle}"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding CultureName, Mode=TwoWay}">
                <ComboBoxItem Tag="en-US" Content="English" />
                <ComboBoxItem Tag="es-MX" Content="Español" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="1"
                    Style="{StaticResource AccountFormPanelStyle}">
            <TextBlock x:Name="pageTitleTextBlock" Text="{Binding [Account_Creation]}"
                       Style="{StaticResource AccountCreationTitleStyle}" />
            <StackPanel Style="{StaticResource ProfileRowStyle}">
                <Button Style="{StaticResource ProfilePictureButtonStyle}">
                    <Image Source="/Assets/Images/imgDefaultProfilePicture.png" />
                </Button>
                <StackPanel Style="{StaticResource NameFieldPanelStyle}">
                    <TextBlock Text="{Binding [Name]}"
                               Style="{StaticResource NameCaptionStyle}" />
                    <TextBox x:Name="usernameTextBox" Style="{StaticResource NameInputStyle}" />
                </StackPanel>
            </StackPanel>
            <Label Content="{Binding [Email]}"
                   Style="{StaticResource AccountFieldLabelStyle}" />
            <TextBox x:Name="emailTextBox"
                     Style="{StaticResource AccountTextInputStyle}" />
            <Label Content="{Binding [Password]}"
                   Style="{StaticResource AccountFieldLabelStyle}" />
            <PasswordBox x:Name="passwordBox"
                         Style="{StaticResource AccountPasswordInputStyle}" />
            <Label Content="{Binding [Password_Confirmation]}"
                   Style="{StaticResource AccountFieldLabelStyle}" />
            <PasswordBox x:Name="confirmPasswordBox"
                         Style="{StaticResource ConfirmationPasswordInputStyle}" />
            <StackPanel Style="{StaticResource AccountActionsPanelStyle}">
                <Button Content="{Binding [Create_Account_Button]}"
                        Style="{StaticResource CreateAccountButtonStyle}" />
                <Button Content="{Binding [Cancel_Button]}"
                        Style="{StaticResource CancelAccountButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
